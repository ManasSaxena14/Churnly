# Churnly backend config. Copy to backend/.env and fill in. Never commit the real .env.

# ── LLM keys (required) ────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/apikey
# Add more as GOOGLE_API_KEY_2 … GOOGLE_API_KEY_32 for more free-tier throughput.
GOOGLE_API_KEY_1=
# Groq console: https://console.groq.com/keys
GROQ_API_KEY_1=

# ── Models (optional — override if your key can't use the defaults) ─
# GEMINI_FAST_MODEL=gemini-3.1-flash-lite
# GEMINI_DEEP_MODEL=gemini-3.5-flash
# GROQ_MODEL=openai/gpt-oss-120b

# ── Reliability (optional) ─────────────────────────────────────────
# LLM_FALLBACK=on                 # off = never switch model/provider
# LLM_MAX_TRANSIENT_RETRIES=2     # backoff retries on 5xx / timeouts
# LLM_MAX_CONCURRENCY=6           # parallel calls per provider

# ── Observability (optional) ───────────────────────────────────────
# Langfuse: https://cloud.langfuse.com → Project settings → API keys
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# USD per 1M tokens [input, output]; unpriced models show cost as "—"
# LLM_PRICES_JSON={"openai/gpt-oss-120b": [0.15, 0.60]}

# ── Stats (optional, for ablations) ────────────────────────────────
# RETAIN_MULTIPLE_TESTING=bh      # none = raw p < 0.05, no BH correction
# RETAIN_DISABLE_ZGATE=0          # 1 = hide significance from the forensic prompt

# ── Background jobs ────────────────────────────────────────────────
INNGEST_DEV=1
# Production (inngest.com → your app → keys):
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ── API hardening (production) ─────────────────────────────────────
# ALLOWED_ORIGINS=https://your-app.vercel.app
# MAX_UPLOAD_MB=25
# RUNS_DIR=/var/data/runs

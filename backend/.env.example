# Churnly backend config. Copy to backend/.env and fill in. Never commit the real .env.
#
# EVERYTHING HERE IS FREE. To guarantee $0:
#   - create the Google AI Studio key in a project WITHOUT billing enabled
#   - stay on Groq's Free plan (no card)
#   - stay on Langfuse Hobby / Inngest Hobby
# Without billing attached, a provider can only rate-limit you (HTTP 429) —
# it can never charge you. The app rotates keys and falls back between
# models when that happens.

# ── LLM keys (required for the AI parts) ───────────────────────────
# Google AI Studio (free, no card): https://aistudio.google.com/apikey
# Add more as GOOGLE_API_KEY_2 … _32 from DIFFERENT free projects for more throughput.
GOOGLE_API_KEY_1=
# Groq console (free plan, no card): https://console.groq.com/keys
# Groq limits are per organisation, so extra keys in the same org don't add quota.
GROQ_API_KEY_1=

# ── Models (optional — defaults are free-tier models) ──────────────
# GEMINI_FAST_MODEL=gemini-3.1-flash-lite
# GEMINI_DEEP_MODEL=gemini-3-flash-preview
# GROQ_MODEL=openai/gpt-oss-120b
# Don't set a "*-pro" Gemini model: Pro is not on the free tier.

# ── Reliability (optional) ─────────────────────────────────────────
# LLM_FALLBACK=on                 # off = never switch model/provider
# LLM_MAX_TRANSIENT_RETRIES=2     # backoff retries on 5xx / timeouts
# LLM_MAX_CONCURRENCY=6           # parallel calls per provider (lower = gentler on free quotas)

# ── Observability (optional, free Hobby plan) ──────────────────────
# Langfuse: https://cloud.langfuse.com → Project settings → API keys
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# Leave LLM_PRICES_JSON unset on free tiers — the cost panel then shows "—"
# instead of a list-price estimate you aren't actually paying.
# LLM_PRICES_JSON={"openai/gpt-oss-120b": [0.15, 0.60]}

# ── Stats (optional, for ablations) ────────────────────────────────
# RETAIN_MULTIPLE_TESTING=bh      # none = raw p < 0.05, no BH correction
# RETAIN_DISABLE_ZGATE=0          # 1 = hide significance from the forensic prompt

# ── Background jobs ────────────────────────────────────────────────
# Local: the free Inngest dev server (`make dev`) — no key needed.
INNGEST_DEV=1
# Production on Inngest Cloud's free Hobby plan (inngest.com → your app → keys):
# INNGEST_DEV=0
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ── API hardening (production) ─────────────────────────────────────
# ALLOWED_ORIGINS=https://your-app.vercel.app
# MAX_UPLOAD_MB=25
# RUNS_DIR=/var/data/runs
